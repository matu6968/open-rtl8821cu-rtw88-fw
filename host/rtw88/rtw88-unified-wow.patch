+
+/* Called without rtwdev->mutex: LED core flushes a worker that takes it. */
+void rtw_led_suspend(struct rtw_dev *rtwdev)
+{
+	if (!rtwdev->led_registered || rtwdev->source_wow_led_suspended)
+		return;
+
+	/* Set LED_SUSPENDED and flush the final LED_OFF while USB is awake. */
+	led_classdev_suspend(&rtwdev->led_cdev);
+	mutex_lock(&rtwdev->mutex);
+	rtwdev->source_wow_led_suspended = true;
+	mutex_unlock(&rtwdev->mutex);
+}
+
+/* USB and firmware have resumed before releasing LED ownership. */
+void rtw_led_resume(struct rtw_dev *rtwdev)
+{
+	if (!rtwdev->led_registered || !rtwdev->source_wow_led_suspended)
+		return;
+
+	mutex_lock(&rtwdev->mutex);
+	rtwdev->source_wow_led_suspended = false;
+	mutex_unlock(&rtwdev->mutex);
+	/* Replay LED core's latest requested brightness and resume its trigger. */
+	led_classdev_resume(&rtwdev->led_cdev);
 }
 
