+
+/* USB core ignores interface suspend errors during system sleep. Register a
+ * wake event as well, so failed preparation cannot silently continue asleep.
+ */
+static int rtw_usb_suspend_error(struct rtw_usb *rtwusb, int error)
+{
+	/* The parent may itself have lost wake authorization. Attribute the
+	 * failure to the interface and unconditionally abort system suspend.
+	 */
+	pm_wakeup_event(rtwusb->rtwdev->dev, 0);
+	pm_system_wakeup();
+	return error;
+}
+
+/* The cfg80211 callback armed the unified firmware before USB core gets here.
+ * Do not stop the MAC, RX DMA or CPU: the firmware must inspect its RX FIFO.
+ */
+int rtw_usb_suspend(struct usb_interface *intf, pm_message_t message)
 {
 	struct ieee80211_hw *hw = usb_get_intfdata(intf);
 	struct rtw_dev *rtwdev;
 	struct rtw_usb *rtwusb;
+	int i;
+
+	if (!hw || PMSG_IS_AUTO(message))
+		return -EOPNOTSUPP;
+	rtwdev = hw->priv;
+	rtwusb = rtw_get_usb_priv(rtwdev);
+	if (rtwdev->source_wow_suspended &&
+	    (!rtwusb->source_wake_setup ||
+	     !device_may_wakeup(&rtwusb->udev->dev)))
+		return rtw_usb_suspend_error(rtwusb, -EOPNOTSUPP);
+
+	flush_workqueue(rtwusb->txwq);
+	for (i = 0; i < ARRAY_SIZE(rtwusb->tx_queue); i++)
+		if (!skb_queue_empty(&rtwusb->tx_queue[i]))
+			return rtw_usb_suspend_error(rtwusb, -EBUSY);
+	if (!usb_wait_anchor_empty_timeout(&rtwusb->tx_anchor, 500))
+		return rtw_usb_suspend_error(rtwusb, -EBUSY);
+
+	WRITE_ONCE(rtwusb->suspended, true);
+	cancel_work_sync(&rtwusb->rx_urb_work);
+	rtw_usb_cancel_rx_bufs(rtwusb);
+	flush_workqueue(rtwusb->rxwq);
+	intf->needs_remote_wakeup = rtwdev->source_wow_suspended;
+	rtw_info(rtwdev, "source USB suspended: remote_wakeup=%u\n",
+		 intf->needs_remote_wakeup);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(rtw_usb_suspend);
+
+int rtw_usb_resume(struct usb_interface *intf)
+{
+	struct ieee80211_hw *hw = usb_get_intfdata(intf);
+	struct rtw_dev *rtwdev;
+	struct rtw_usb *rtwusb;
+
+	if (!hw)
+		return -ENODEV;
+	rtwdev = hw->priv;
+	rtwusb = rtw_get_usb_priv(rtwdev);
+	if (READ_ONCE(rtwusb->suspended)) {
+		WRITE_ONCE(rtwusb->suspended, false);
+		rtw_usb_setup_rx(rtwdev);
+	}
+	intf->needs_remote_wakeup = 0;
+	rtw_info(rtwdev, "source USB resumed\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(rtw_usb_resume);
+
+int rtw_usb_reset_resume(struct usb_interface *intf)
+{
+	struct ieee80211_hw *hw = usb_get_intfdata(intf);
+
+	if (hw) {
+		struct rtw_dev *rtwdev = hw->priv;
+
+		/* A bus reset invalidates an association-preserving claim. */
+		rtwdev->source_wow_reset = true;
+	}
+	return rtw_usb_resume(intf);
+}
+EXPORT_SYMBOL_GPL(rtw_usb_reset_resume);
